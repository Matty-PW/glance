#!/bin/sh
# glance pre-commit hook. Refuses a commit that contains:
#   1. model weights, audio, images, env files or signing material,
#   2. any file larger than MAX_BYTES,
#   3. secrets or personal home-directory paths (gitleaks, see .gitleaks.toml).
#
# Enable once per clone:  git config core.hooksPath .githooks
set -eu

MAX_BYTES=2000000
fail=0

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks). Commit refused." >&2
  exit 1
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)

# 1. File types that must never be committed, even when force-added past .gitignore.
#    PNGs are allowed only in docs/images/ (README images, see its README.md).
blocked=$(printf '%s\n' "$staged" | grep -v '^docs/images/[^/]*\.png$' | grep -iE \
  '\.(gguf|onnx|onnx\.data|safetensors|pt|pth|bin|pkl|ckpt|npz|wav|flac|mp3|png|p12|pem|key|cer|mobileprovision)$|(^|/)\.env' \
  || true)
if [ -n "$blocked" ]; then
  echo "pre-commit: these file types are not allowed in the repo:" >&2
  printf '  %s\n' $blocked >&2
  fail=1
fi

# 2. Size cap: nothing in this repo should be large.
printf '%s\n' "$staged" | while IFS= read -r path; do
  [ -n "$path" ] || continue
  size=$(git cat-file -s ":$path" 2>/dev/null || echo 0)
  if [ "$size" -gt "$MAX_BYTES" ]; then
    echo "pre-commit: $path is $size bytes (limit $MAX_BYTES)." >&2
    exit 1
  fi
done || fail=1

# 3. Secrets and personal paths in the staged diff. --redact keeps any finding
#    out of the terminal scrollback.
if ! gitleaks git --pre-commit --staged --redact --no-banner \
      --config "$(git rev-parse --show-toplevel)/.gitleaks.toml" .; then
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: commit refused." >&2
  exit 1
fi
